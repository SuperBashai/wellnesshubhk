# Decodo Web Scraping API Basic Auth token from the Decodo dashboard.
# Paste the base64 token only, without the leading word "Basic".
DECODO_AUTH_TOKEN=

# Supabase (provided automatically when the Supabase project is connected in Vercel)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_with_your_publishable_key
SUPABASE_SECRET_KEY=replace_with_your_secret_key

# Legacy Vercel/Supabase integrations can use these names instead:
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=replace_with_your_service_role_key
# Server-only key used to load attributed, non-cached Google Place Photos.
GOOGLE_PLACES_API_KEY=
